{
  "root-2": {
    "site": "root",
    "button": "送信",
    "fields": [
      {
        "name": "f1",
        "label": "お名前",
        "type": "text",
        "required": true,
        "description": "(ローマ字入力)"
      },
      {
        "name": "f2",
        "label": "体験希望言語 (複数も可)",
        "type": "checkbox",
        "required": true,
        "choices": [
          "英語、英会話",
          "その他（中国語、仏語、西語、独語、韓国語、伊語、露語、アラビア語など）",
          "まだよくわからないので、相談したい。"
        ]
      },
      {
        "name": "f3",
        "label": "Email",
        "type": "email",
        "required": true
      },
      {
        "name": "f4",
        "label": "体験レッスンとは別日程で、15分程度のオンライン事前カウンセリングを実施しております。ご希望の時間帯（6:00AM〜夜21：00迄）をご記入下さい。土日祝日も可。",
        "type": "textarea",
        "required": false,
        "description": "(体験レッスンの質を高める効果がありますので是非協力お願いします。)",
        "placeholder": "例：平日20時以降ならいつでも可能。"
      },
      {
        "name": "f5",
        "label": "今回の体験レッスンお申し込みにあたり、当校のどのような所に興味をお持ちになったかお書き添え頂ければ幸いです。",
        "type": "textarea",
        "required": false
      }
    ]
  },
