{
  "root-2": {
    "site": "root",
    "button": "申し込む",
    "fields": [
      {
        "name": "f1",
        "label": "お名前",
        "type": "text",
        "required": true
      },
      {
        "name": "target",
        "label": "受講される方",
        "type": "radio",
        "required": true,
        "choices": [
          "大人",
          "子供（17歳以下）"
        ]
      },
      {
        "name": "f2",
        "label": "体験希望言語 (複数も可)",
        "type": "checkbox",
        "required": true,
        "choices": [
          "英語、英会話",
          "その他（中国語、仏語、西語、独語、韓国語、伊語、露語、アラビア語など）",
          "まだよくわからないので、相談したい。"
        ]
      },
      {
        "name": "f3",
        "label": "Email",
        "type": "email",
        "required": true
      },
      {
        "name": "tel",
        "label": "電話番号",
        "type": "phone",
        "required": true,
        "placeholder": "例：090-1234-5678",
        "description": "ご連絡用です。カードでお支払いの方は、お支払い画面（Square）にも自動で入ります。"
      },
      {
        "name": "consult",
        "label": "事前相談（無料・約15分）",
        "type": "radio",
        "required": true,
        "choices": [
          "希望する（日本人スタッフがオンラインで、学習の目的や予約サイトの使い方をご説明します。お支払いは、事前相談のあとで結構です）",
          "希望しない（体験レッスン代をSquareで決済し、レッスンは会員サイトから自分で予約します）"
        ]
      },
      {
        "name": "f4",
        "label": "事前相談・体験レッスンのご希望の時間帯（事前相談は8:00〜20:00）",
        "type": "textarea",
        "required": false,
        "placeholder": "例：平日の夜、土曜の午前など。"
      },
      {
        "name": "f5",
        "label": "今回の体験レッスンお申し込みにあたり、当校のどのような所に興味をお持ちになったかお書き添え頂ければ幸いです。",
        "type": "textarea",
        "required": false
      }
    ],
    "payment": "trial"
  },
