---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Slider from '../components/Slider.astro';
import Form from '../components/Form.astro';
import RecentGrid from '../components/RecentGrid.astro';
import LangBlog from '../components/LangBlog.astro';
import TopPage from '../components/lp/TopPage.astro';
import KidsPage from '../components/lp/KidsPage.astro';
import CorporatePage from '../components/lp/CorporatePage.astro';
import OsakaPage from '../components/lp/OsakaPage.astro';
import AdultPage from '../components/lp/AdultPage.astro';
import TrialPage from '../components/lp/TrialPage.astro';
import TrialKidsPage from '../components/lp/TrialKidsPage.astro';
import TeachersKidsPage from '../components/lp/TeachersKidsPage.astro';
import LanguageIntro from '../components/lp/LanguageIntro.astro';
import PricePage from '../components/lp/PricePage.astro';
import KidsShell from '../components/lp/KidsShell.astro';
import SchoolsPage from '../components/lp/SchoolsPage.astro';
import SchoolsShell from '../components/lp/SchoolsShell.astro';
import BeginnerPage from '../components/lp/BeginnerPage.astro';
import FeaturesPage from '../components/lp/FeaturesPage.astro';
import FaqsPage from '../components/lp/FaqsPage.astro';
import FaqsKidsPage from '../components/lp/FaqsKidsPage.astro';
import OnkiPage from '../components/lp/OnkiPage.astro';
import OnkiShell from '../components/lp/OnkiShell.astro';
import languages from '../data/languages.json';
import { sites, categories, tags, siteOf, siteKeyOf, sortPosts, postPath, blogPath, formatDate, categoryPath, allCategories, inCategory, chunk, param, langOf, langForPath, type Site } from '../lib';

type Props =
  | { kind: 'page'; page: CollectionEntry<'pages'>; list?: CollectionEntry<'posts'>[]; pageNo?: number; pages?: number }
  | { kind: 'post'; post: CollectionEntry<'posts'> }
  | { kind: 'list'; site: Site; title: string; base: string; list: CollectionEntry<'posts'>[]; pageNo: number; pages: number };

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = sortPosts(await getCollection('posts'));
  const bySite = (key: string) => posts.filter((p) => siteKeyOf(p) === key);
  const out: { params: { path: string | undefined }; props: Props }[] = [];
  const seen = new Set<string>();
  const add = (path: string, props: Props) => {
    const key = param(path) ?? '';
    if (seen.has(key)) return;
    seen.add(key);
    out.push({ params: { path: param(path) }, props });
  };

  for (const post of posts) add(postPath(post), { kind: 'post', post });
  for (const page of pages) {
    const site = siteOf(page);
    if (page.data.postsPage) {
      const chunks = chunk(bySite(site.key));
      chunks.forEach((list, i) => add(i === 0 ? page.data.path : `${page.data.path}page/${i + 1}/`, { kind: 'page', page, list, pageNo: i + 1, pages: chunks.length }));
    } else {
      add(page.data.path, { kind: 'page', page });
    }
  }
  for (const site of Object.values(sites)) {
    const all = bySite(site.key);
    // トップが記事一覧のサイト、または投稿ページが無いサイトの /blog/
    if (site.frontIsPosts || !pages.some((p) => siteOf(p) === site && p.data.postsPage)) {
      const base = blogPath(site);
      if (all.length || site.frontIsPosts) {
        const chunks = chunk(all);
        chunks.forEach((list, i) => add(i === 0 ? base : `${base}page/${i + 1}/`, { kind: 'list', site, title: site.frontIsPosts ? site.name : 'ブログ', base, list, pageNo: i + 1, pages: chunks.length }));
      }
    }
    for (const cat of allCategories(site.key, all)) {
      const list = all.filter((p) => inCategory(site.key, p, cat.name));
      if (!list.length) continue;
      const chunks = chunk(list);
      chunks.forEach((l, i) => add(i === 0 ? cat.path : `${cat.path}page/${i + 1}/`, { kind: 'list', site, title: cat.name, base: cat.path, list: l, pageNo: i + 1, pages: chunks.length }));
    }
    for (const tag of tags[site.key] ?? []) {
      const list = all.filter((p) => p.data.tags.includes(tag.name));
      if (!list.length) continue;
      const chunks = chunk(list);
      chunks.forEach((l, i) => add(i === 0 ? tag.path : `${tag.path}page/${i + 1}/`, { kind: 'list', site, title: `タグ: ${tag.name}`, base: tag.path, list: l, pageNo: i + 1, pages: chunks.length }));
    }
  }
  return out;
}

const props = Astro.props as Props;
const entry = props.kind === 'page' ? props.page : props.kind === 'post' ? props.post : undefined;
const site = props.kind === 'list' ? props.site : siteOf(entry!);
const { Content } = entry ? await render(entry) : { Content: undefined };
const formKeys = entry?.data.forms ?? [];
const home = `${site.base}/`;
const template = props.kind === 'page' ? props.page.data.template : undefined;
const Landing = template === 'top' ? TopPage : template === 'kids' ? KidsPage : template === 'corporate' ? CorporatePage : template === 'osaka' ? OsakaPage : template === 'adult' ? AdultPage : template === 'trial' ? TrialPage : template === 'trialKids' ? TrialKidsPage : template === 'teachersKids' ? TeachersKidsPage : template === 'price' ? PricePage : template === 'schools' ? SchoolsPage : template === 'onki' ? OnkiPage : template === 'beginner' ? BeginnerPage : template === 'features' ? FeaturesPage : template === 'faqs' ? FaqsPage : template === 'faqsKids' ? FaqsKidsPage : undefined;
// 言語ページの説明文は languages.json の言語名から作る
const langName = template === 'language' && props.kind === 'page' ? (languages as Record<string, { name: string }>)[props.page.data.path]?.name : undefined;
const description = props.kind === 'page' ? props.page.data.description ?? (langName ? `オンライン${langName}レッスン。担任のプロ講師とAI、ふたりで教えるオンライン語学学習。日本語や英語が分かるプロ講師とマンツーマン、レッスンのない日はAIレッスンで${langName}の会話ができます。` : undefined) : undefined;
// 子供サイトは、専用デザインのないページも子供向けの枠で表示する（K 2026-10-26）
const kids = site.key === 'english_children';
// 学校サイトも、専用デザインのないページを学校トップと同じ枠で表示する。見るのは学校の先生（K 2026-10-27）
const schools = site.key === 'english_schools';
// Onki（アプリ）も、専用デザインのないページをトップと同じ枠で表示する（K 2026-10-27）
const onki = site.key === 'english_onki';
const sitePosts = props.kind === 'post' ? sortPosts(await getCollection('posts', (p) => siteKeyOf(p) === site.key)) : [];
---
{props.kind === 'page' && Landing && (
  <Base site={site} title={props.page.data.front ? site.name : props.page.data.title} description={description} noindex={props.page.data.noindex}>
    <Landing />
    {formKeys.length > 0 && (
      <section class="lp-form" id="form">
        <div class="wrap">
          <h2>{template === 'osaka' ? '塾代助成専用 無料体験レッスンのお申し込み' : template === 'trial' || template === 'trialKids' ? '体験レッスンのお申し込み' : 'お申し込み'}</h2>
          {formKeys.map((k) => <Form formKey={k} />)}
        </div>
      </section>
    )}
    {(template === 'adult' || template === 'kids' || template === 'corporate') && <LangBlog lang="english" />}
  </Base>
)}
{/* コース・クラスの説明ページ（template: course）。本文の HTML が .lp の部品で組んであるので、枠を付けずにそのまま出す（K 2026-10-27） */}
{props.kind === 'page' && template === 'course' && (
  <Base site={site} title={props.page.data.title} description={description} noindex={props.page.data.noindex}>
    <div class="lp ad course"><Content /></div>
  </Base>
)}
{props.kind === 'page' && !Landing && template !== 'course' && kids && (
  <Base site={site} title={props.page.data.title} description={description} noindex={props.page.data.noindex}>
    <KidsShell title={props.page.data.title}>
      <div class="prose kd-prose"><Content /></div>
      {formKeys.map((k) => <Form formKey={k} />)}
      {props.page.body?.includes('data-recent-posts') && <RecentGrid site={site} />}
      {props.list && <PostList list={props.list} pageNo={props.pageNo!} pages={props.pages!} base={props.page.data.path} />}
    </KidsShell>
  </Base>
)}
{props.kind === 'page' && !Landing && template !== 'course' && schools && (
  <Base site={site} title={props.page.data.title} description={description} noindex={props.page.data.noindex}>
    <SchoolsShell title={props.page.data.title} path={props.page.data.path} servicesIndex={props.page.data.path === '/schools/services/'} crumbs={props.page.data.path.startsWith('/schools/services/') && props.page.data.path !== '/schools/services/' ? [{ href: '/schools/services/', label: '授業の目的から選ぶ' }] : []}>
      <div class="prose sc-prose"><Content /></div>
      {formKeys.map((k) => <Form formKey={k} />)}
      {props.page.body?.includes('data-recent-posts') && <RecentGrid site={site} />}
      {props.list && <PostList list={props.list} pageNo={props.pageNo!} pages={props.pages!} base={props.page.data.path} />}
    </SchoolsShell>
  </Base>
)}
{props.kind === 'page' && !Landing && template !== 'course' && onki && (
  <Base site={site} title={props.page.data.title} description={description} noindex={props.page.data.noindex}>
    <OnkiShell title={props.page.data.title} path={props.page.data.path} usesIndex={props.page.data.path === '/english/onki/use/'} crumbs={props.page.data.path.startsWith('/english/onki/use/') && props.page.data.path !== '/english/onki/use/' ? [{ href: '/english/onki/use/', label: '使い方の例' }] : []}>
      <div class="prose ok-prose"><Content /></div>
      {formKeys.map((k) => <Form formKey={k} />)}
      {props.page.body?.includes('data-recent-posts') && <RecentGrid site={site} />}
      {props.list && <PostList list={props.list} pageNo={props.pageNo!} pages={props.pages!} base={props.page.data.path} />}
    </OnkiShell>
  </Base>
)}
{props.kind === 'page' && !Landing && template !== 'course' && !kids && !schools && !onki && (
  <Base site={site} title={props.page.data.front ? site.name : props.page.data.title} description={description} noindex={props.page.data.noindex}>
    {props.page.data.slides.length > 0 && <Slider slides={props.page.data.slides} />}
    <div class="wrap">
      {!props.page.data.front && <nav class="breadcrumb"><a href={home}>Home</a> » {props.page.data.title}</nav>}
      {/* トップページ（旧サイトのまま）は見出しがスライダーの画像だけなので、検索エンジン向けに見えない h1 を置く */}
      {props.page.data.front ? <h1 class="sr-only">{site.name} – {site.tagline}</h1> : <h1>{props.page.data.title}</h1>}
      {template === 'language' && <LanguageIntro path={props.page.data.path} />}
      <div class="prose"><Content /></div>
      {formKeys.map((k) => <Form formKey={k} />)}
      {props.page.body?.includes('data-recent-posts') && <RecentGrid site={site} />}
      {props.list && <PostList list={props.list} pageNo={props.pageNo!} pages={props.pages!} base={props.page.data.path} />}
    </div>
    {template === 'language' && langForPath(props.page.data.path) && <LangBlog lang={langForPath(props.page.data.path)!} />}
  </Base>
)}
{props.kind === 'post' && kids && (
  <Base site={site} title={props.post.data.title} description={props.post.data.description} image={props.post.data.image} type="article" lang={langOf(props.post)} published={props.post.data.date} modified={props.post.data.updated}>
    <KidsShell title={props.post.data.title} crumbs={[{ href: blogPath(site), label: 'ブログ' }]}>
      <p slot="meta" class="kd-meta">
        <span>📅 {formatDate(props.post.data.date)}</span>
        {props.post.data.categories.map((c) => {
          const href = categoryPath(site.key, c);
          return href ? <a class="kd-tag" href={href}>{c}</a> : <span class="kd-tag">{c}</span>;
        })}
      </p>
      <div class="layout">
        <article class="prose kd-prose"><Content />{formKeys.map((k) => <Form formKey={k} />)}</article>
        <aside class="sidebar kd-side">
          <h2>📚 カテゴリー</h2>
          <ul>{allCategories(site.key, sitePosts).filter((c) => !c.parent).map((c) => <li><a href={c.path}>{c.name}</a></li>)}</ul>
        </aside>
      </div>
    </KidsShell>
  </Base>
)}
{props.kind === 'post' && schools && (
  <Base site={site} title={props.post.data.title} description={props.post.data.description} image={props.post.data.image} type="article" lang={langOf(props.post)} published={props.post.data.date} modified={props.post.data.updated}>
    <SchoolsShell title={props.post.data.title} crumbs={props.post.data.categories.map((c) => ({ href: categoryPath(site.key, c) ?? blogPath(site), label: c })).slice(0, 1)}>
      <p slot="meta" class="sc-meta">{formatDate(props.post.data.date)}</p>
      <div class="layout">
        <article class="prose sc-prose"><Content />{formKeys.map((k) => <Form formKey={k} />)}</article>
        <aside class="sidebar sc-side">
          <h2>カテゴリー</h2>
          <ul>{allCategories(site.key, sitePosts).filter((c) => !c.parent).map((c) => <li><a href={c.path}>{c.name}</a></li>)}</ul>
        </aside>
      </div>
    </SchoolsShell>
  </Base>
)}
{props.kind === 'post' && onki && (
  <Base site={site} title={props.post.data.title} description={props.post.data.description} image={props.post.data.image} type="article" lang={langOf(props.post)} published={props.post.data.date} modified={props.post.data.updated}>
    <OnkiShell title={props.post.data.title} crumbs={[{ href: blogPath(site), label: '活用コラム' }]}>
      <p slot="meta" class="sc-meta">{formatDate(props.post.data.date)}</p>
      <article class="prose ok-prose ok-narrow"><Content />{formKeys.map((k) => <Form formKey={k} />)}</article>
    </OnkiShell>
  </Base>
)}
{props.kind === 'post' && !kids && !schools && !onki && (
  <Base site={site} title={props.post.data.title} description={props.post.data.description} image={props.post.data.image} type="article" lang={langOf(props.post)} published={props.post.data.date} modified={props.post.data.updated}>
    <div class="wrap layout">
      <article>
        <nav class="breadcrumb"><a href={home}>Home</a> » <a href={blogPath(site)}>ブログ</a> » {props.post.data.title}</nav>
        <h1>{props.post.data.title}</h1>
        <div class="meta">
          {formatDate(props.post.data.date)}
          {props.post.data.categories.map((c) => {
            const href = categoryPath(site.key, c);
            return <> · {href ? <a href={href}>{c}</a> : c}</>;
          })}
        </div>
        <div class="prose"><Content /></div>
        {formKeys.map((k) => <Form formKey={k} />)}
      </article>
      <aside class="sidebar">
        <h2>カテゴリー</h2>
        <ul>{allCategories(site.key, sitePosts).filter((c) => !c.parent).map((c) => <li><a href={c.path}>{c.name}</a></li>)}</ul>
      </aside>
    </div>
  </Base>
)}
{props.kind === 'list' && kids && (
  <Base site={site} title={props.title}>
    <KidsShell title={props.title}>
      <PostList list={props.list} pageNo={props.pageNo} pages={props.pages} base={props.base} />
    </KidsShell>
  </Base>
)}
{props.kind === 'list' && schools && (
  <Base site={site} title={props.title}>
    <SchoolsShell title={props.title}>
      <PostList list={props.list} pageNo={props.pageNo} pages={props.pages} base={props.base} />
    </SchoolsShell>
  </Base>
)}
{props.kind === 'list' && onki && (
  <Base site={site} title={props.title}>
    <OnkiShell title={props.title}>
      <PostList list={props.list} pageNo={props.pageNo} pages={props.pages} base={props.base} />
    </OnkiShell>
  </Base>
)}
{props.kind === 'list' && !kids && !schools && !onki && (
  <Base site={site} title={props.title}>
    <div class="wrap">
      <nav class="breadcrumb"><a href={home}>Home</a> » {props.title}</nav>
      <h1>{props.title}</h1>
      <PostList list={props.list} pageNo={props.pageNo} pages={props.pages} base={props.base} />
    </div>
  </Base>
)}
