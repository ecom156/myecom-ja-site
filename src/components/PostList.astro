---
import type { CollectionEntry } from 'astro:content';
import { postPath, formatDate } from '../lib';

interface Props { list: CollectionEntry<'posts'>[]; pageNo: number; pages: number; base: string }
const { list, pageNo, pages, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
<ul class="post-list">
  {list.map((p) => (
    <li class={p.data.image ? '' : 'no-image'}>
      {p.data.image && <a href={postPath(p)}><img src={p.data.image} alt="" loading="lazy" /></a>}
      <div>
        <h2><a href={postPath(p)}>{p.data.title}</a></h2>
        <div class="meta">{formatDate(p.data.date)}{p.data.categories.length > 0 && ` · ${p.data.categories.join('、')}`}</div>
        {p.data.description && <p>{p.data.description}…</p>}
      </div>
    </li>
  ))}
</ul>
{pages > 1 && (
  <nav class="pager">
    {pageNo > 1 && <a href={href(pageNo - 1)}>« 前へ</a>}
    <span>{pageNo} / {pages}</span>
    {pageNo < pages && <a href={href(pageNo + 1)}>次へ »</a>}
  </nav>
)}
