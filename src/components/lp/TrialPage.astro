---
import Faq from './Faq.astro';
import TrialLd from './TrialLd.astro';
import plans from '../../data/plans.json';

// 体験レッスン。大人・他言語は /trial/、子供は /english/children/trial/ の2つ（K 2026-10-25）
// 要点→有料の理由→内容→流れ→事前相談→よくある質問→フォームの順
interface Props { kids?: boolean }
const { kids = false } = Astro.props;
const kidsTrial = '/english/children/trial/';
const kup = '/english/children/wp-content/uploads/sites/2';
const facts = [
  { icon: '💴', title: plans.trial.price, text: kids ? '税込・お一人さま1回' : '税込・お一人さま各言語1回' },
  { icon: '⏱️', title: '30分×2回', text: '60分1回にまとめてもOK' },
  kids ? { icon: '🎒', title: '3歳〜17歳', text: '英会話・英検®対策' } : { icon: '🌏', title: '20言語', text: '英語・中国語・フランス語など' },
];
// 体験で分かる3つのこと。子供の体験ページと同じ構成を、大人向けの文にした（K 2026-10-29）
const learn = [
  { icon: '🤝', title: '先生との相性', text: '体験用の先生ではなく、入会後も続けられる先生とのレッスン。話しやすさや教え方が合うか、ご自身で確かめられます。' },
  { icon: '📊', title: '授業内容', text: 'レッスン後、授業内容をまとめたレポートが、日本語でメール送信されます。復習にもそのまま使えます。' },
  { icon: '🏅', title: '学習プラン', text: 'TOEIC®や英検®、仕事や旅行など、目標までに必要な回数や期間を、事務局・先生がご提案します。' },
];
const teachers = [
  { img: '/english/img/teachers/jessica.jpg', name: 'Jessica' },
  { img: '/english/img/teachers/alan.jpg', name: 'Alan' },
  { img: '/english/img/teachers/kathryn.jpg', name: 'Kathryn' },
];
const reasons = [
  { icon: '🎓', title: '採用率0.5%のプロ講師', text: '200人に1人の講師が担当します。入会後に担任となる候補の先生なので、相性をそのまま確かめられます。' },
  { icon: '📝', title: kids ? 'お子さまに合わせた事前準備' : 'あなたに合わせた事前準備', text: kids ? 'お申込みの内容（学年・英語の経験・英検®の目標）を読んで、先生が教材と進め方を準備してからレッスンに入ります。' : 'お申込みの内容（目的・今のレベル・ご希望）を読んで、先生が教材と進め方を準備してからレッスンに入ります。' },
  { icon: '📋', title: '本番同様のレッスン', text: '他校のように、体験用の先生が短時間対応し、大半が日本人営業マンの勧誘といったことはありません。' },
];
const details = [
  { icon: '👩‍🏫', title: '講師', text: 'ネイティブ講師、または日本語が分かるバイリンガル講師。全員が日本語を理解できます。' },
  { icon: '🗓️', title: '日時', text: 'レッスンは24時間、早朝や深夜も。2回は同じ日でも別の日でもかまいません。' },
];
const steps = [
  { icon: '✍️', title: 'フォームからお申込み', text: '入力は1分ほど。送信すると、そのままSquareのお支払い画面に移ります。' },
  { icon: '💻', title: '会員サイトで予約', text: 'お支払いを確認したら、会員サイトのご案内をメールでお送りします。お好きな先生・時間を選んで予約してください。' },
  { icon: '🗣️', title: '体験レッスン（30分×2回）', text: '本番同様のレッスンを受けてください。続けたい方は、会員サイトからそのまま入会できます。' },
];
// 体験レッスンを受けた保護者・生徒の声（旧ページから）
const voices = [
  { who: '3歳（お母さま代筆）', text: '近所の英会話教室では落ち着いて参加できなかったのですが、先生の熱心な授業に引き込まれました。レッスンのあと「今度いつ会えるの？」と聞くのがうれしくて入会を決めました。' },
  { who: '8歳（お母さま代筆）', text: '上級レベルの授業にも対応していただけました。年齢でクラスが決まる学校と違い、マンツーマンでどんどん進めるのがありがたいです。' },
  { who: '17歳', text: '留学から帰ってきて、日本で英語力を落とさないようにするのに最適でした。イギリス人の先生とイギリスの話題で盛り上がりました。' },
];
const faq = [
  { q: 'なぜ無料ではなく有料なのですか？', a: '採用率0.5%のプロ講師が、事前準備をしっかりして授業を行うためです。お試しのおしゃべりではなく、入会後と同じ本番のレッスンとしてご案内しています。' },
  { q: '体験のあと、入会しなくてもいいですか？', a: 'はい。強引な勧誘はいたしません。続けたい方だけ、会員サイトからご入会ください。' },
  ...(kids
    ? [
        { q: '人見知りの子や、小さい子でも大丈夫ですか？', a: 'はい。担任制で毎回同じ先生なので、だんだん慣れていきます。3歳から受けられ、小さいお子さまは保護者の方が隣にいても大丈夫です。' },
        { q: '英検®対策の体験もできますか？', a: 'はい。お申込みフォームに受験予定の級を書いていただければ、英検®対策の内容で体験できます。<a href="/english/children/courses/examinations/eiken">英検®対策コース</a>もご覧ください。' },
        { q: '大阪市の塾代助成を使いたいです。', a: '塾代助成をお使いの方は、無料体験（1回）の専用ページからお申込みください。<a href="/english/children/osaka-jukudai-josei">大阪市塾代助成のページ</a>' },
      ]
    : [
        { q: '子供の体験はどこから申し込めますか？', a: `17歳以下のお子さまは、<a href="${kidsTrial}">子供の体験レッスン</a>のページからお申込みください。` },
        { q: '法人で研修を検討しています。', a: '法人のご担当者さまは、<a href="/corporation/">法人向けオンライン英語研修</a>のページからご相談ください。' },
      ]),
  { q: 'パソコンやオンラインに不安があります。', a: 'お申込みフォームで「事前相談を希望する」を選ぶと、日本人スタッフが音声の確認と予約サイトの使い方をご案内します（8:00〜20:00）。' },
];
---
<TrialLd kids={kids} />
<div class={`lp tr${kids ? ' tr-kids' : ''}`}>
  <section class="lp-sec ad-hero">
    <div class="lp-in">
      <div class="lp-hero">
        <div>
          <p class="lp-eyebrow">{kids ? '子供の体験レッスン（3歳〜17歳）' : '体験レッスン（大人・20言語）'}</p>
          {kids
            ? <h1>うちの子を分かってくれる<br /><span class="nw">先生か、体験で確かめる。</span></h1>
            : <h1>実際のECOMサービスを体験</h1>}
          <p class="lp-lead">{kids ? '入会後と同じプロ講師と、30分のマンツーマンレッスンを2回。お子さまと先生の相性と、上達の手応えを確かめてください。' : '30分のマンツーマンレッスンを2回。先生との相性と、上達の手応えを確かめてください。'}</p>
          <ul class="tr-facts">
            {facts.map((f) => <li><i aria-hidden="true">{f.icon}</i><b>{f.title}</b><span>{f.text}</span></li>)}
          </ul>
          {/* 体験後3日以内の入会特典。事務局が手動で付ける（K 2026-10-30） */}
          <p class="tr-bonus"><b>体験後3日以内のご入会特典</b>AIレッスン「毎日3分」（通常月1,980円）を、1ヶ月無料でお付けします。</p>
          <div class="lp-btns">
            <a class="lp-btn" href="#form">{plans.trial.label}</a>
            <a href="#why">なぜ有料なの？</a>
          </div>
          <p class="lp-note">{!kids && <>17歳以下のお子さまは<a href={kidsTrial}>子供の体験レッスン</a>へ。</>}</p>
        </div>
        {kids
          ? <img src={`${kup}/2018/03/English-girl-good-1024x683.jpg`} alt="オンラインで英語のレッスンを受ける生徒" width="1024" height="683" />
          : <img src="/wp-content/uploads/2023/01/Grouplessons-image-ver2.jpg" alt="ECOMのネイティブ・バイリンガル講師" width="1170" height="500" />}
      </div>
    </div>
  </section>

  {!kids && (
    <section class="lp-sec soft">
      <div class="lp-in">
        <h2>体験で分かる、3つのこと</h2>
        <div class="lp-cards">
          {learn.map((l) => <div class="lp-card ad-feat"><i aria-hidden="true">{l.icon}</i><b>{l.title}</b><span>{l.text}</span></div>)}
        </div>
      </div>
    </section>
  )}

  <section class="lp-sec" id="why">
    <div class="lp-in">
      <div class="lp-head">
        <p class="lp-eyebrow">有料の理由</p>
        <h2>お試しではなく、<span class="nw">本気の体験レッスンです。</span></h2>
      </div>
      <p class="tr-why">採用率0.5%のプロ講師が、事前準備をしっかりして授業を行うため、本気の有料体験としてご案内しています。</p>
      <div class="lp-cards">
        {reasons.map((r, i) => (
          <div class="lp-card ad-feat">
            <i aria-hidden="true">{r.icon}</i>
            <b>{r.title}</b>
            <span>{r.text}</span>
            {i === 0 && (
              <ul class="tr-faces">
                {teachers.map((t) => <li><img src={t.img} alt={`${t.name}先生`} width="400" height="400" loading="lazy" /></li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <h2>体験レッスンの内容</h2>
      <div class="lp-cards">
        {details.map((d) => (
          <div class="lp-card ad-feat tr-detail"><i aria-hidden="true">{d.icon}</i><b>{d.title}</b><span>{d.text}</span></div>
        ))}
      </div>
    </div>
  </section>

  {kids && (
    <section class="lp-sec warm">
      <div class="lp-in">
        <h2>体験レッスンを受けた方の声</h2>
        <div class="lp-cards">
          {voices.map((v) => <figure class="lp-quote kd-voice"><figcaption>{v.who}</figcaption><blockquote>{v.text}</blockquote></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="lp-sec">
    <div class="lp-in">
      <h2>お申込みから体験まで</h2>
      <ol class="tr-steps">
        {steps.map((s, i) => (
          <li><i aria-hidden="true">{s.icon}</i><em>STEP {i + 1}</em><b>{s.title}</b><span>{s.text}</span></li>
        ))}
      </ol>
      <div class="lp-sechead tr-consult">
        <img src="/wp-content/uploads/2024/08/image_photo_office.jpg" alt="ECOMのオフィス（東京・千代田区）" width="885" height="221" loading="lazy" />
        <div>
          <b>はじめての方は、無料の事前相談（約15分）もどうぞ</b>
          <p>日本人スタッフがオンラインで、音声の確認、目的に合う先生やクラスのご提案、予約サイトの使い方をご案内します。対応時間は<strong>8:00〜20:00</strong>です。フォームで「希望する」を選んでください。相談のあとにお支払いいただきます。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in narrow">
      <h2>よくある質問</h2>
      <Faq items={faq} />
      <a class="ad-ai" href="https://ai.myecom.net">
        <i aria-hidden="true">🤖</i>
        <span><b>まずは無料で試したい方へ</b>AI講師と話せる「ECOM AIレッスン」は、無料の会員登録だけで10分お試しいただけます。</span>
        <em>AI講師を無料で10分試す →</em>
      </a>
    </div>
  </section>
</div>
