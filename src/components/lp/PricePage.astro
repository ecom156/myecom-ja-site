---
import PlanCards from './PlanCards.astro';
import Faq from './Faq.astro';
import plans from '../../data/plans.json';

// 料金ページ（/price/）。文字が多くて迷うとの声で、情報設計からやり直した（K 2026-10-26）
// 共通ルール（ひと目で）→ 選び方 → 月額プラン → チケット → 子供 → 法人・学校 → お支払い → 細かいルール（質問形式）の順。料金は plans.json の1か所で直す
const facts = [
  { c: 'c1', icon: '🆓', b: '入会金 0円', s: '月額プランもチケットも' },
  { c: 'c2', icon: '⏱️', b: '1回30分', s: 'レッスン25分＋フィードバック5分' },
  { c: 'c3', icon: '🌏', b: '20言語 同じ料金', s: '英語もほかの言語も' },
  { c: 'c4', icon: '👨‍👩‍👧', b: '大人も子供も同じ', s: 'ご家族でチケットを共有OK' },
];
const choose = [
  { icon: '📅', title: '毎週、決まったペースで', text: '月額プランがおすすめ。月4回なら週1回ペースで、AI講師も付きます。', href: '#monthly', more: '月額プランを見る' },
  { icon: '🧭', title: '自分のペースで、必要な分だけ', text: 'チケットのまとめ買い。自動更新はありません。3枚から買えます。', href: '#price-adult', more: 'チケットを見る' },
  { icon: '🔥', title: '試験や出張の前に、集中して', text: '30枚（1ヶ月有効）なら、ほぼ毎日受講できます。1回3,000円です。', href: '#price-adult', more: 'チケットを見る' },
  { icon: '👨‍👩‍👧', title: 'ご家族みんなで', text: '160枚をまとめて買い、家族で分けて使う方が多いです。1回2,997円です。', href: '#price-adult', more: 'チケットを見る' },
];
const pay = [
  { icon: '🎒', title: '体験レッスン', b: plans.trial.price, text: 'お申込み時にクレジットカード（Square）で' },
  { icon: '📅', title: '月額プラン', b: 'カード払い・毎月自動更新', text: '解約は、次回お支払い日の7日前までにご連絡ください' },
  { icon: '🎫', title: 'チケットのまとめ買い', b: '銀行振込', text: 'ネットバンキングなら、その日のうちに手続きできます' },
];
const faq = [
  { q: '予約の変更やキャンセルはできますか？', a: 'レッスン開始の1時間前まで、変更・キャンセルできます。開始12時間前を過ぎてからのキャンセルは、チケット0.5枚分のキャンセル料がかかります。' },
  { q: 'チケットの有効期限は、いつから数えますか？', a: 'チケットを使い始めた日から数えます。買った日からではありません。' },
  { q: '家族でチケットを分けて使えますか？', a: 'はい。ご本人はビジネス英語、お子さまは英会話、配偶者の方はフランス語、といった使い方ができます。チケットはECOMの20言語すべてで使えます。' },
  { q: '月額プランはいつでもやめられますか？', a: 'はい。次回お支払い日の7日前までにご連絡いただければ、その次の月から止まります。' },
  { q: '領収書はもらえますか？', a: 'はい。いつでも発行できます。' },
  { q: '福岡市の子ども習い事応援事業のクーポンは使えますか？', a: 'はい、使えます。ただし、クーポンで買ったチケットはご家族と共有できません。<a href="/english/children/fukuoka-coupon">くわしくはこちら</a>' },
];
---
<div class="lp pr">
  <section class="lp-sec pr-hero">
    <div class="lp-in">
      <div class="lp-head">
        <p class="pr-eyebrow">💴 料金</p>
        <h1><span class="nw">大人も子供も、どの言語も、</span><span class="nw">同じわかりやすい料金です。</span></h1>
        <p class="lp-sub">毎月決まった回数を受ける「月額プラン」と、必要な分だけ買う「チケット」の2つから選べます。</p>
      </div>
      <ul class="pr-facts">
        {facts.map((f) => <li class={f.c}><i aria-hidden="true">{f.icon}</i><b>{f.b}</b><span>{f.s}</span></li>)}
      </ul>
      <nav class="pr-jump" aria-label="このページの目次">
        <a href="#choose">🤔 選び方</a><a href="#monthly">📅 月額プラン</a><a href="#price-adult">🎫 チケット</a><a href="#price-kids">🧒 子供</a><a href="#price-business">🏢 法人・学校</a><a href="#payment">💳 お支払い</a>
      </nav>
    </div>
  </section>

  <section class="lp-sec soft" id="choose">
    <div class="lp-in">
      <h2>🤔 どちらを選べばいい？</h2>
      <div class="lp-cards ad-feats">
        {choose.map((c) => <a class="lp-card ad-feat pr-choose" href={c.href}><i aria-hidden="true">{c.icon}</i><b>{c.title}</b><span>{c.text}</span><em>{c.more} ↓</em></a>)}
      </div>
    </div>
  </section>

  <section class="lp-sec" id="monthly">
    <div class="lp-in">
      <div class="lp-head">
        <h2>📅 月額プラン</h2>
        <p class="lp-sub">毎月決まった回数を受けるプランです。続けやすく、月4回からAI講師が付きます。</p>
      </div>
      <PlanCards signup compact />
      <ul class="pr-mini">
        <li>🆓 入会金0円</li><li>💳 カード払い（Square）</li><li>🔁 毎月自動更新</li><li>✋ 解約は次回お支払い日の7日前まで</li>
      </ul>
      <p class="lp-note">体験レッスンのあと、ご希望のプランの「申し込む」からお申し込みください。まだの方は <a href="/trial/">体験レッスン</a> からどうぞ。</p>
    </div>
  </section>

  <section class="lp-sec soft" id="price-adult">
    <div class="lp-in">
      <div class="lp-head">
        <h2>🎫 チケットのまとめ買い</h2>
        <p class="lp-sub">チケット1枚で30分のレッスン1回。自動更新はなく、自分のペースで使えます。たくさん買うほど1回あたりがお得です。</p>
      </div>
      <div class="pr-tickets">
        {plans.tickets.map((t) => (
          <div class={`pr-ticket${t.badge ? ' hl' : ''}`}>
            {t.badge && <span class="lp-badge">{t.badge}</span>}
            <b>{t.n}</b>
            <p class="price">{t.price}</p>
            <p class="per">1回 <strong>{t.per}</strong></p>
            <p class="limit">⏳ 有効期限 {t.limit}</p>
          </div>
        ))}
      </div>
      <p class="lp-note">料金は税込です。有効期限は、使い始めた日から数えます。</p>
      <div class="pr-discount">
        <b>🎁 続けるほど割引</b>
        <ul>{plans.ticketDiscount.map((d) => <li>{d.n}<strong>{d.off}</strong></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="lp-sec" id="price-kids">
    <div class="lp-in">
      <div class="lp-row">
        <div class="lp-box pr-box kids">
          <b>🧒 子供（17歳以下）</b>
          <span class="lp-sub">料金は大人と同じです。</span>
          <ul>
            <li>🏅 英検®対策で回数を増やしたい → <b>月8回</b></li>
            <li>🏖️ テスト期間は休み、長期休みに集中 → <b>チケット</b></li>
            <li>👨‍👩‍👧 兄弟姉妹で → <b>チケットを家族で共有</b></li>
          </ul>
          <span><a href="/english/children/trial/">子供の体験レッスン →</a><br /><a href="/english/children/">子供のオンライン英会話を見る →</a></span>
        </div>
        <div class="lp-box pr-box" id="price-business">
          <b>🏢 法人・学校</b>
          <span class="lp-sub">講師1時間 <strong>{plans.corporate.hourly}</strong>（税抜）が基本です。グループは、クラスの人数に応じた参加者管理料（{plans.corporate.group[0].fee}〜）が加わります。人数・回数・内容に合わせてお見積りします。</span>
          <ul>
            <li>👥 グループ研修・マンツーマン研修</li>
            <li>📊 研修前後のレベル判定</li>
          </ul>
          <span><a href="/corporation/">法人向けページで資料請求・お見積り →</a><br /><a href="/schools/">学校・教職員の方はこちら →</a></span>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec soft" id="payment">
    <div class="lp-in">
      <h2>💳 お支払い方法</h2>
      <div class="lp-cards">
        {pay.map((p) => <div class="lp-card ad-feat"><i aria-hidden="true">{p.icon}</i><span class="lp-tag">{p.title}</span><b>{p.b}</b><span>{p.text}</span></div>)}
      </div>
      <p class="lp-note">🧾 領収書はいつでも発行できます。</p>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-in narrow">
      <h2>❓ 細かいルール</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <div class="lp-end">
        <p>まずは体験レッスンから。</p>
        <div class="lp-btns">
          <a class="lp-btn" href="/trial/">{plans.trial.label}</a>
          <a href="https://ai.myecom.net">まずは無料で、AI講師と10分話してみる</a>
        </div>
      </div>
    </div>
  </section>
</div>
