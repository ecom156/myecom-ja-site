---
import Faq from './Faq.astro';
import plans from '../../data/plans.json';

// 法人研修のトップ（/corporation/）。研修の進め方は「成果を測る」「楽しく続ける」の2択、AIはオプション（K 2026-10-24）
// 選ばれる理由は「手厚い進捗管理」「業務特化カスタマイズ」「柔軟な契約形態」の3つ。申込みは資料請求より「オンライン導入相談」へつなぐ（K 2026-10-29）
const base = '/corporation';
const contact = `${base}/contact/`;
const docs = `${base}/documents/`;
const { hourly, entryFee, group } = plans.corporate;
const faq = [
  { q: '何人から申し込めますか？', a: `1人から申し込めます。グループ研修は2人からで、1時間${hourly}（税抜）に、クラスの人数に応じた参加者管理料（${group[0].fee}〜）が加わります。` },
  { q: '英語以外の言語でも研修できますか？', a: '中国語・韓国語・フランス語・ドイツ語・スペイン語など、20言語で研修できます。' },
  { q: 'AI講師を使わなくてもいいですか？', a: 'はい。AI講師はオプションです。講師とのレッスンだけで研修できます。' },
  { q: '社内のセキュリティで使えるツールが限られています。', a: 'Microsoft Teams・Google Meetなど、使い慣れたツールで受講できます。独自のソフトを入れる必要はありません。' },
  { q: '受講状況は確認できますか？', a: '人事担当者向けのダッシュボードで、出席率や習熟度テストの結果をいつでも確認できます。修了証や、ご希望に応じて出席表・成果表もお出しします。' },
  { q: '請求書払いはできますか？', a: 'はい。請求書払い（後払い）に対応しています。受講枠は社員間でシェアできるので、受講者が入れ替わっても無駄が出ません。' },
  { q: '導入相談は、どのように行いますか？', a: 'Google Meet・Teamsを使ったオンラインで行います。目的・人数・ご予算を伺い、研修プランとお見積りをご提案します。<a href="/corporation/contact/">オンライン導入相談を申し込む</a>' },
];
---
<div class="lp">
  <section class="lp-sec soft">
    <div class="lp-in">
      <div class="lp-hero">
        <div>
          <p class="lp-eyebrow">企業・官公庁・学校のオンライン語学研修</p>
          <h1>上達が見える<span class="nw">ECOMの語学研修</span></h1>
          <ul class="lp-balloons">
            <li><b>96.5%</b>が満足して研修継続</li>
            <li>講師の平均在籍<b>11年</b></li>
            <li><b>20言語</b>の研修に対応</li>
            <li><b>豊富な実績</b></li>
            <li><b>AI講師</b>にも対応</li>
          </ul>
          <div class="lp-btns">
            <a class="lp-btn" href={contact}>オンライン導入相談（無料）</a>
            <a href={docs}>資料をダウンロード</a>
          </div>
          <p class="lp-note">Google Meet・Teamsで、ご担当者さまと画面を見ながらご相談します。</p>
        </div>
        <img src="/english/corporation/wp-content/uploads/sites/3/2024/09/group-lessons00-middle.jpg" alt="オンラインのグループ英語研修" />
      </div>
    </div>
  </section>

  <section class="lp-sec line">
    <div class="lp-in">
      <p><b>導入実績</b>　<span class="lp-sub">デジタル庁・海上保安庁・警察大学校・内閣府などの官公庁をはじめ、ホテル・小売・医薬品・商社・金融・アパレル・貿易・製造業の企業研修に、20年以上の実績があります。</span> <a href={`${base}/online-group/examples/`}>研修実績例</a></p>
      <div class="lp-logos">
        <img src="/english/corporation/wp-content/uploads/sites/3/2025/02/JCG-logo.jpg" alt="海上保安庁" loading="lazy" />
        <img src="/english/corporation/wp-content/uploads/sites/3/2016/01/logo-keisatsu-university.jpg" alt="警察大学校" loading="lazy" />
        <img src="/english/corporation/wp-content/uploads/sites/3/2016/01/logo_co-150x59.gif" alt="内閣府" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="lp-sec" id="reasons">
    <div class="lp-in">
      <div class="lp-head">
        <h2>法人がECOMを選ぶ、3つの理由</h2>
        <p class="lp-sub">研修を「やりっぱなし」にしない仕組みと、御社の仕事に合わせた中身、続けやすい契約の形です。</p>
      </div>
      <div class="lp-cards corp-reasons">
        <div class="lp-card"><span class="corp-ico" aria-hidden="true">📊</span><span class="lp-tag">手厚い進捗管理</span><b>人事担当者向けの<span class="nw">ダッシュボード</span></b><span>出席率や習熟度テストの結果を、ひと目で分かる形で確認できます。受講が止まっている社員にも、すぐ気づけます。</span><ul><li>出席率・受講状況</li><li>習熟度テスト（33段階のレベル判定）の結果</li><li>修了証・出席表・成果表もお出しします</li></ul><a href={`${base}/online-group/report/`}>成果の報告について</a></div>
        <div class="lp-card"><span class="corp-ico teal" aria-hidden="true">🛠️</span><span class="lp-tag teal">業務特化カスタマイズ</span><b>業種・職種に合わせた<span class="nw">カリキュラム</span></b><span>自社で教材を作っているので、御社の仕事で使う場面に合わせて内容を組み立てます。</span><ul><li>英語でのプレゼンテーション</li><li>英文メール・会議</li><li>海外赴任前の研修</li></ul><a href={`${base}/online-group/examples/`}>研修実績例</a></div>
        <div class="lp-card"><span class="corp-ico" aria-hidden="true">🤝</span><span class="lp-tag">柔軟な契約形態</span><b>請求書払いと、<span class="nw">受講枠のシェア</span></b><span>経理の手間が少なく、受講する社員が入れ替わっても無駄が出ない契約です。</span><ul><li>請求書払い（後払い）に対応</li><li>受講枠を社員間でシェアできる</li><li>1人から申し込める</li></ul><a href={`${base}/online-group/price/`}>料金と契約</a></div>
      </div>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <div class="lp-head">
        <h2>目的に合わせて選べる、2つの研修</h2>
        <p class="lp-sub">どちらからでも始められ、途中で変えることもできます。</p>
      </div>
      <div class="lp-cards">
        <div class="lp-card wide">
          <span class="corp-ico" aria-hidden="true">📈</span><span class="lp-tag">海外赴任・昇格・TOEICの目標がある会社に</span><b>成果を測る研修</b>
          <span>研修の最初と半年ごとにレベルを測り、伸びをご担当者さまに報告します。</span>
          <ul><li>0〜10++の33段階でレベルを判定（英検・TOEIC対応表つき）</li><li>目標レベルまでの時間と費用を最初に試算</li><li>研修後に、受講者へ学習アドバイスをお送りします</li></ul>
          <a href="/english/level/">33段階のレベル早見表</a>
        </div>
        <div class="lp-card wide">
          <span class="corp-ico teal" aria-hidden="true">💬</span><span class="lp-tag teal">福利厚生・社内コミュニケーションに</span><b>楽しく続ける研修</b>
          <span>レベル測定なしで、グループのビジネス英会話を気軽に楽しみます。</span>
          <ul><li>テストなしで始められます</li><li>テーマを決めたグループでの会話</li><li>出席を報告します</li></ul>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-in">
      <h2>研修の形</h2>
      <div class="lp-cards">
        <a class="lp-card" href={`${base}/online-group/`}><img src="/english/corporation/wp-content/uploads/sites/3/2024/09/group-lessons00-middle-300x169.jpg" alt="オンラインのグループ研修" loading="lazy" /><b>グループ研修</b><span>2人から、大人数のクラスまで。1時間{hourly}（税抜）に、クラスの人数に応じた参加者管理料が加わります。10人なら1人1時間840円からです。</span><i>くわしく →</i></a>
        <a class="lp-card" href={`${base}/online-private/`}><img src="/english/corporation/wp-content/uploads/sites/3/2024/09/private-training-native-middle-300x200.jpg" alt="ネイティブ講師とのマンツーマン研修" loading="lazy" /><b>マンツーマン研修</b><span>一人ひとりの業務に合わせた内容で、1時間{hourly}（税抜）。時間も個別に予約できます。</span><i>くわしく →</i></a>
        <a class="lp-card" href={`${base}/edtech/`}><img src="/english/corporation/wp-content/uploads/sites/3/2018/02/videos-training-300x180.jpg" alt="研修用の学習動画" loading="lazy" /><b>研修動画の制作</b><span>自己学習用に、御社専用の学習動画と教材を作ります。大人数の研修や反転学習に。</span><i>くわしく →</i></a>
        <a class="lp-card" href={`${base}/virtual-languageschool/`}><img src="/english/corporation/wp-content/uploads/sites/3/2015/12/jenn-projector-small.jpg" alt="会議室の画面でオンラインレッスン" loading="lazy" /><b>講師派遣・社内教室</b><span>講師が御社の会議室に伺うか、会議室をオンライン専用の教室にします。</span><i>くわしく →</i></a>
      </div>
      <div class="lp-box"><b>AI講師（オプション）</b><span class="lp-sub">ご希望の会社だけ、AI講師と話せるようにします。レッスン前の口慣らしや、毎日の練習に使えます。使わない研修も選べます。データの扱いはご相談のときにご説明します。</span></div>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <h2>研修の流れ</h2>
      <ol class="lp-steps">
        <li><em>1</em><b>オンライン導入相談</b><span>フォームから日程をご相談ください。Google Meet・Teamsで、目的・人数・ご予算を伺います。しつこい営業電話や、延々と続くメールは一切ありません。</span></li>
        <li><em>2</em><b>研修の設計</b><span>目的・期間・人数から、時間と費用をお見積りします。成果を測る研修では、最初にレベルを測ります。</span></li>
        <li><em>3</em><b>受講</b><span>担任講師がオンラインで研修します。受講者の環境チェックは、サポートチームが無料で個別に対応します。</span></li>
        <li><em>4</em><b>報告・修了</b><span>出席率や習熟度テストの結果は、ダッシュボードでいつでも確認できます。修了証と、ご希望に応じて出席表・成果表もお出しします。</span></li>
      </ol>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-in">
      <div class="lp-head">
        <h2>費用の目安</h2>
        <p class="lp-sub">すべて税抜。講師1時間あたり{hourly}が基本です。グループは、クラスの人数に応じた参加者管理料が加わります。</p>
      </div>
      <div class="lp-cards">
        <div class="lp-plan"><p class="name">マンツーマン 月2時間</p><p class="price">14,000円<small> / 人・月</small></p></div>
        <div class="lp-plan"><p class="name">グループ（2〜10人）1時間×月4回</p><p class="price">33,600円<small> / グループ・月</small></p><p class="lead">10人なら1人あたり3,360円</p></div>
        <div class="lp-plan"><p class="name">1レベル上げる（マンツーマン）</p><p class="price">210,000円<small> / 人</small></p><p class="lead">約60時間のうち、レッスンは約30時間（残りはAI・自習）</p></div>
      </div>
      <div class="lp-table cg-fee">
        <table>
          <caption>グループ研修の料金（1クラス1時間・税抜）：基本料{hourly}＋参加者管理料</caption>
          <thead><tr><th>クラスの人数</th><th>参加者管理料</th><th>1時間あたり</th></tr></thead>
          <tbody>
            {group.map((g) => <tr><td>{g.size}</td><td>{g.fee}</td><td><b>{g.hourly}</b></td></tr>)}
          </tbody>
        </table>
        <p class="lp-note">グループの1時間は、50分のレッスンと、講師がフィードバックを書く10分です。</p>
      </div>
      <p class="lp-note">法人入会金{entryFee}（税抜）。有効期限は受講開始から1年。請求書払い（後払い）に対応し、受講枠は社員間でシェアできます。<a href={`${base}/online-group/price/`}>料金と事例を詳しく見る</a></p>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <h2>研修を支える仕組み</h2>
      <div class="lp-cards">
        <div class="lp-card"><b>プロのネイティブ講師</b><span>ベルリッツやECC経験者を中心に、採用率0.5%（200人に1人）の基準で選んだ講師が教えます。日本語が分かる講師も多数います。</span></div>
        <div class="lp-card"><b>24時間365日</b><span>国内・海外の講師がシフトを組んで対応。予約サイトからいつでも予約できます。</span></div>
        <div class="lp-card"><b>使い慣れたTeams・Google Meet</b><span>独自のシステムを入れないので、社内のセキュリティ確認の手間がかかりません。</span></div>
      </div>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-in">
      <h2>研修部門マネージャーから</h2>
      <div class="lp-person">
        <img src="/english/corporation/wp-content/uploads/sites/3/2015/12/katsu.jpg" alt="成田勝行" loading="lazy" />
        <div>
          <p>新卒で入った会社の英語研修は、テキストと短い電話レッスンだけで、あまり意味のないものでした。入社後のグループ研修も、参加者のレベルがまちまちで、どこに合わせているのか分からないレッスンでした。</p>
          <p>語学研修を無駄遣いで終わらせないために、インターネットを活用してECOMをつくりました。ぜひ私たちの研修ノウハウをお試しください。</p>
          <p><b style="color: var(--ink)">成田勝行</b>　慶應大学卒、アクセンチュア出身。英検1級取得。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <h2>学校・教育機関の方へ</h2>
      <p class="lp-sub">授業内のオンライン英会話や、英検®の面接練習にご利用いただけます。</p>
      <p><a href="/schools/">学校向けのご案内を見る</a>　・　<a href={`${base}/contact-school/`}>ECOMについて</a></p>
    </div>
  </section>

  <section class="lp-sec">
    <div class="lp-in narrow">
      <h2>よくある質問</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section class="lp-sec soft">
    <div class="lp-in">
      <div class="lp-end">
        <p>オンラインで、人数と目的を伺って費用をお見積りします。ダッシュボードの画面もお見せします。</p>
        <div class="lp-btns">
          <a class="lp-btn" href={contact}>オンライン導入相談（無料）</a>
          <a href={docs}>資料をダウンロード</a>
        </div>
      </div>
      <p class="lp-sub">研修担当の方へ：<a href={`${base}/checkpoint/`}>語学研修選びで気を付けたい5つのチェックポイント</a>　・　<a href={`${base}/online-group/report/`}>成果の見える語学研修への取り組み</a>　・　<a href={`${base}/contact-school/`}>ECOMについて</a>　・　<a href={`${base}/blog/`}>研修ブログ</a></p>
    </div>
  </section>
</div>
