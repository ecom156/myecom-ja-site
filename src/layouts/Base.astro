---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { sites, siteForPath, sortPosts, postPath, siteKeyOf, langOf, langForPath, type Site } from '../lib';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  site?: Site;
  // 異文化ブログの言語圏（english, chinese など）
  lang?: string;
  // 検索に出さない（送信完了ページなど）
  noindex?: boolean;
  // 記事の公開日・更新日（構造化データ用）
  published?: Date;
  modified?: Date;
}
const site = Astro.props.site ?? siteForPath(Astro.url.pathname);
const { title, description = `${site.name} – ${site.tagline}`, image, type = 'website' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} – ${site.tagline}` : `${title} – ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = decodeURI(Astro.url.pathname);
const year = new Date().getFullYear();
const home = `${site.base}/`;
// 言語ページ（/chinese/ など）と異文化ブログの記事では、同じ言語圏の記事だけを出す
const lang = Astro.props.lang ?? (site.key === 'root' || site.key === 'russian' ? langForPath(current) : undefined);
const recent = sortPosts(await getCollection('posts', (p) => (lang ? langOf(p) === lang : siteKeyOf(p) === site.key))).slice(0, 5);
const ogImage = image ?? site.logo;
// GA は全サイト共通で TOP のプロパティに送り、どのサイトのページかはコンテンツグループで分ける
const ga = sites.root.ga;
// 検索エンジンと AI 検索向けの構造化データ（運営者・サイト・パンくず・記事）
const org = {
  '@type': 'EducationalOrganization',
  '@id': new URL('/#organization', Astro.site).href,
  name: sites.root.name,
  alternateName: 'ECOM',
  url: new URL('/', Astro.site).href,
  logo: new URL(sites.root.logo ?? '/favicon.ico', Astro.site).href,
  foundingDate: '2005-02',
  email: 'info@myecom.net',
  address: { '@type': 'PostalAddress', postalCode: '102-0082', addressRegion: '東京都', addressLocality: '千代田区', streetAddress: '一番町6 相模屋本社ビル7階', addressCountry: 'JP' },
  parentOrganization: { '@type': 'Corporation', name: '株式会社イーコミュニケーション', url: 'https://ecominc.co.jp/' },
  sameAs: ['https://www.youtube.com/@ecomenglish'],
};
const crumbs = [{ name: site.name, url: new URL(home, Astro.site).href }];
if (canonical.href !== crumbs[0].url) crumbs.push({ name: title, url: canonical.href });
const graph: Record<string, unknown>[] = [org];
if (current === '/') graph.push({ '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: sites.root.name, url: crumbs[0].url, inLanguage: 'ja', publisher: { '@id': org['@id'] } });
if (crumbs.length > 1) graph.push({ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) });
if (type === 'article') graph.push({
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  inLanguage: 'ja',
  ...(ogImage && { image: new URL(ogImage, Astro.site).href }),
  ...(Astro.props.published && { datePublished: Astro.props.published.toISOString() }),
  ...((Astro.props.modified ?? Astro.props.published) && { dateModified: (Astro.props.modified ?? Astro.props.published)!.toISOString() }),
  author: { '@id': org['@id'] },
  publisher: { '@id': org['@id'] },
});
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {site.icon && <link rel="icon" href={site.icon} />}
    <link rel="sitemap" href="/sitemap.xml" />
    {/* 旧サイトのページ本文（WPBakery の段組み・表・アイコン）用の CSS */}
    <link rel="stylesheet" href="/wp-content/plugins/js_composer/assets/css/js_composer.min.css" />
    <link rel="stylesheet" href="/wp-content/plugins/easy-tables-vc/assets/css/style.min.css" />
    <link rel="stylesheet" href="/wp-content/plugins/easy-tables-vc/assets/css/themes.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/v4-shims.min.css" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
    {ga && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
    {ga && (
      <script is:inline define:vars={{ ga, group: site.name }}>
        window.dataLayer = window.dataLayer || [];
        // define:vars で関数の中に入るので、フォームなど他のスクリプトから使えるよう window に置く
        window.gtag = function gtag(){dataLayer.push(arguments);};
        gtag('js', new Date());
        gtag('config', ga, { content_group: group });
      </script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={home}>{site.logo ? <img src={site.logo} alt={site.name} /> : <span>{site.name}</span>}</a>
        {site.cta && <a class="header-cta" href={site.cta.href}>{site.cta.label}</a>}
        <details class="menu-toggle"><summary>メニュー</summary></details>
        <ul class="nav">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
              {item.children && (
                <ul class="sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                      {c.children && <ul class="sub2">{c.children.map((g) => <li><a href={g.href}>{g.label}</a></li>)}</ul>}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-cols">
        {recent.length > 0 && (
          <div>
            <h2>最近の投稿</h2>
            <ul>{recent.map((p) => <li><a href={postPath(p)}>{p.data.title}</a></li>)}</ul>
          </div>
        )}
        {site.footer.map((m) => (
          <div>
            {m.title && <h2>{m.title}</h2>}
            <ul>{m.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="wrap copyright">© {year} {site.name} – 運営 <a href="https://ecominc.co.jp/">株式会社イーコミュニケーション</a></div>
      <div class="wrap copyright ip-notice">ECOM®は株式会社イーコミュニケーションの登録商標です（登録第6540469号）。「<a href="/english/children/initial-memory/">頭出し記憶法</a>」は同社の特許です（特許第7036483号）。</div>
    </footer>
  </body>
</html>
